---
// Cluster article route: one canonical route per post, under its OWNING hub
// (from `category`). alsoRelevantTo only cross-lists the post on other hubs —
// it never creates a second route. Slugs resolve through src/config/hubs.ts.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { serializeJsonLd, articleJsonLd, breadcrumbJsonLd, faqPageJsonLd, type JsonLd } from '../../lib/jsonld';
import { HUB_LABELS, HUB_PARAMS, HUB_SLUGS, hubCategoryForParam } from '../../config/hubs';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return posts.map((post) => ({
    params: { hub: HUB_PARAMS[post.data.category], slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

// Only hub params resolve to a category; anything else is not an article route.
const category = hubCategoryForParam(Astro.params.hub);
if (!category || Astro.params.slug !== Astro.props.post.data.slug) {
  return new Response(null, { status: 404 });
}

const { post } = Astro.props;
const { Content } = await render(post);

// Related: sibling clusters of the owning lane (same `category`, non-draft,
// self excluded). Collection-driven; every sibling is listed.
const siblings = (
  await getCollection(
    'posts',
    ({ data }) =>
      (import.meta.env.PROD ? !data.draft : true) &&
      data.category === category &&
      data.slug !== post.data.slug,
  )
).map((sibling) => ({
  href: `${HUB_SLUGS[category]}${sibling.data.slug}/`,
  title: sibling.data.title,
}));

const canonicalPath = `${HUB_SLUGS[category]}${post.data.slug}/`;

const jsonLd: JsonLd[] = [
  await articleJsonLd({
    headline: post.data.title,
    datePublished: post.data.datePublished,
    dateModified: post.data.dateModified,
    path: canonicalPath,
  }),
  breadcrumbJsonLd([
    { path: '/', label: 'Home' },
    { path: HUB_SLUGS[category], label: HUB_LABELS[category] },
    { path: canonicalPath, label: post.data.title },
  ]),
];
if (post.data.faq && post.data.faq.length > 0) {
  jsonLd.push(faqPageJsonLd(post.data.faq));
}
---

<Base title={post.data.title} description={post.data.description}>
  <nav aria-label="Breadcrumb">
    <a href={HUB_SLUGS[category]}>{HUB_LABELS[category]}</a>
  </nav>
  <article>
    <h1>{post.data.title}</h1>
    <div class="article-body">
      <Content />
    </div>
  </article>
  {
    siblings.length > 0 && (
      <nav aria-label="Related">
        <h2>Related</h2>
        <ul>
          {siblings.map((sibling) => (
            <li>
              <a href={sibling.href}>{sibling.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <script slot="jsonld" type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
</Base>
