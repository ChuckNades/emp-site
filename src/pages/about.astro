---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import portrait from '../assets/brand/emp-portrait-graded-1000.png';
import { serializeJsonLd, profilePageJsonLd, personJsonLd, breadcrumbJsonLd } from '../lib/jsonld';

const jsonLd = [
  await profilePageJsonLd('/about/'),
  await personJsonLd(),
  breadcrumbJsonLd([
    { path: '/', label: 'Home' },
    { path: '/about/', label: 'About' },
  ]),
];

// Alt text comes from the people collection's pete entry name (accessibility
// text, not copy); empty-safe fallback while the bio fields stay unfilled.
const pete = await getEntry('people', 'pete');
const portraitAlt = pete?.data.name || 'Portrait';
---

<Base title="About" description="About EMP">
  <h1>About</h1>
  <section aria-label="Bio">
    <Pic src={portrait} alt={portraitAlt} widths={[400, 800, 1000]} sizes="(max-width: 1000px) 100vw, 1000px" />
  </section>
  <script slot="jsonld" type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
</Base>
