---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import portrait from '../assets/brand/emp-portrait-graded-1000.png';
import { serializeJsonLd, profilePageJsonLd, personJsonLd, breadcrumbJsonLd } from '../lib/jsonld';

const jsonLd = [
  await profilePageJsonLd('/about/'),
  await personJsonLd(),
  breadcrumbJsonLd([
    { path: '/', label: 'Home' },
    { path: '/about/', label: 'About' },
  ]),
];

// Alt text comes from the people collection's pete entry name (accessibility
// text, not copy); empty-safe fallback while the bio fields stay unfilled.
const pete = await getEntry('people', 'pete');
const portraitAlt = pete?.data.name || 'Portrait';
---

<Base title="About" description="About EMP">
  <h1>About</h1>
  <section aria-label="Bio" class="bio">
    <Pic src={portrait} alt={portraitAlt} widths={[400, 800, 1000]} sizes="(max-width: 640px) calc(100vw - 48px), 1000px" />
  </section>
  <script slot="jsonld" type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
</Base>

<style>
  /* V2: the graded portrait is a square composition; keep the full frame
     reading on mobile instead of over-filling the narrow viewport. Tokens
     only — no new values. */
  .bio :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 640px) {
    .bio :global(img) {
      width: 100%;
      object-position: center top;
    }
  }
</style>
