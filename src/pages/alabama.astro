---
import Base from '../layouts/Base.astro';
import { serializeJsonLd, breadcrumbJsonLd } from '../lib/jsonld';
import { licensureStatement, nmls } from '../data/facts';

const jsonLd = [
  breadcrumbJsonLd([
    { path: '/', label: 'Home' },
    { path: '/alabama/', label: 'Alabama' },
  ]),
];
---

<Base title="Alabama" description="Alabama">
  <h1>Alabama</h1>
  <p id="licensure">{licensureStatement}</p>
  <p id="nmls">{nmls}</p>
  <nav aria-label="City hubs">
    <ul>
      <li><a href="/huntsville/">Huntsville</a></li>
      <li><a href="/birmingham/">Birmingham</a></li>
    </ul>
  </nav>
  <script slot="jsonld" type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
</Base>
